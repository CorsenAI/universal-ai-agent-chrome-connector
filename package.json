{
  "name": "universal-ai-agent-chrome-connector",
  "version": "0.1.0",
  "private": true,
  "description": "Universal AI Agent Chrome Connector — by Corsen AI. Your signed-in web chats become a local OpenAI/Anthropic API, your whitelisted tabs become an MCP server.",
  "license": "Apache-2.0",
  "author": "Corsen AI",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "dev": "pnpm -r --parallel run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "typecheck": "pnpm -r run typecheck && tsc --noEmit -p tsconfig.json",
    "start": "node packages/daemon/dist/index.js start",
    "setup-agents": "node packages/daemon/dist/index.js setup",
    "clean": "pnpm -r exec rm -rf dist",
    "screenshots": "CAPTURE=1 vitest run --config e2e/vitest.config.ts e2e/capture.e2e.ts",
    "package:extension": "node scripts/package-extension.mjs",
    "verify:extension": "node scripts/verify-extension-zip.mjs",
    "store:assets": "STORE_ASSETS=1 vitest run --config e2e/vitest.config.ts e2e/store-assets.e2e.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
